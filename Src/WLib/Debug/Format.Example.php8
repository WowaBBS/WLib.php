<?
  for($F=__FILE__; $F;) if(@include($F=DirName($F)).'/Using.php') break;
  $Loader->GetLogger()->ScriptLog();
  
  $Loader->Load_Lib('/Debug/Format' ); Use \WLib\Debug\Format As Debug;
  $Loader->Load_Lib('/Log/Logger'   ); Use \WLib\Log\Logger;
  
  $Data='0123456789abcdef0123456789abcdef00';
  Logger::Log('HexDump :', Debug::HexDump ($Data));
  Logger::Log('HexDump :', Debug::HexDump ($Data, ['Addr'=> 1]));
  Logger::Log('HexDump :', Debug::HexDump ($Data, ['Addr'=>15]));
  
  $Table=Debug::ToMap([
    ['File'           ,'Size', 'Float'    ],
    ['Date.phpt'      ,  548 ,    3.1415  ],
    ['Func.phpt'      , 1771 , 1415.3     ],
    ['Hash.phpt'      ,  834 , 3.14e40    ],
    ['IntId.phpt'     , 1062 , 3.1415e-40 ],
    ['Item.phpc'      , 1980 ,    0       ],
    ['Manager.phpc'   , 5468 , ACos(8)    ],
    ['Modes.Test.php' ,    0 ,  Log(0)    ],
    ['Item.phpc'      , 1980 ,   -1       ],
    [True             , False,   Null     ],
  ]);
  
  Logger::Log('Table   :', Debug::Table   ($Table));
  Logger::Log('Format numeric and marks: [1, 2, 3.14, -2e4, 5 >= 7>>1]');
  
  Logger::Log('Numeric :', Debug::Numeric (1_234_567));
  Logger::Log('Size    :', Debug::Size    (1_234_567));
  Logger::Log('SizeNew :', Debug::Size    (1_234_567, ',New')); // KiB MiB
  Logger::Log('SizeHdd :', Debug::Size    (1_234_567, ',Dec')); // K is 1000 instaed of 1024
  Logger::Log('Speed   :', Debug::Speed   (1_234_567));
  Logger::Log('Time    :', Debug::Time    (1_234_567));
  Logger::Log('Time    :', Debug::Time    (1.2345e-7));
  
  $Loader->Dispose();
