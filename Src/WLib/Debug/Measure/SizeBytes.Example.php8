<?
  for($F=__FILE__; $F;) if(@include($F=DirName($F)).'/Using.php') break;
  $Loader->GetLogger()->ScriptLog();
  $Loader->Load_Lib('/Debug/Format'); Use \WLib\Debug\Format As Debug;
  
  $Sizes=[
    0,
    1,
    10,
    100,
    1_000,
    10_000,
    100_000,
    1_000_000,
    10_000_000,
    100_000_000,
    1_000_000_000,
    10_000_000_000,
    100_000_000_000,
    1_000_000_000_000,
    10_000_000_000_000,
    100_000_000_000_000,
    1_000_000_000_000_000,
    10_000_000_000_000_000,
    100_000_000_000_000_000,
    1_000_000_000_000_000_000,
  ];
  
  $Table=[];
  ForEach($Sizes As $Size)
    $Table[]=[
      'Numeric' =>Debug::Numeric($Size),
      'Size'    =>Debug::Size($Size),         // Most popular
      'New'     =>Debug::Size($Size, ',New'), // KiB MiB
      'Hdd'     =>Debug::Size($Size, ',Dec'), // K is 1000 instaed of 1024
      'Time>'   =>Debug::Time($Size, ';*p'),
      'Time<'   =>Debug::Time(1/Max($Size,1)),
    ];
  $Loader->Log('Debug', 'Size:', Debug::Table($Table));

  $Loader->Dispose();
