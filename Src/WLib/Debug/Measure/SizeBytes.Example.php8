<?
  for($F=__FILE__; $F;) if(@include($F=DirName($F)).'/Using.php') break;
  $Loader->GetLogger()->ScriptLog();
//$Loader->Load_Type('/Debug/Measure/Value'); Use Function \WLib\Debug\Measure\{Size, Value, Time};
  $Loader->Load_Lib('/Debug/Format'); Use \WLib\Debug\Format As Debug;
  
  $Sizes=[
    0,
    1,
    10,
    100,
    1_000,
    10_000,
    100_000,
    1_000_000,
    10_000_000,
    100_000_000,
    1_000_000_000,
    10_000_000_000,
    100_000_000_000,
    1_000_000_000_000,
    10_000_000_000_000,
    100_000_000_000_000,
    1_000_000_000_000_000,
    10_000_000_000_000_000,
    100_000_000_000_000_000,
    1_000_000_000_000_000_000,
  ];
  
  $Log=$Loader->Log('Debug', 'Size:');
  ForEach($Sizes As $Size)
  //$Log(Value($Size), '=>', Size($Size), '=>', Time($Size), '=>', Time(1/Max($Size,1)));
    $Log(
      Debug::Numeric($Size), '=>', 
      Debug::Size($Size), '=>', 
      Debug::Time($Size), '=>', 
      Debug::Time(1/Max($Size,1))
    );
  $Log->Done();
//$Loader->Log('Debug', 'ToMap:')->Dump();

  $Loader->Dispose();
