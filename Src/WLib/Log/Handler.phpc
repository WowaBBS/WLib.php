<?
  $Loader->Parent_Class('/Log/Handler/List');
 
  Class C_Log_Handler Extends C_Log_Handler_List
  {
    Var $Error     =Null;
    Var $Exception =Null;
    Var $ShutDown  =Null;
    Var $OutPut    =Null;
  
    Function _Init(Array $Args)
    {
      $this->Error     =$this->Add($this->Create_Object('/Log/Handler/Error'     ));
      $this->Exception =$this->Add($this->Create_Object('/Log/Handler/Exception' ));
      $this->ShutDown  =$this->Add($this->Create_Object('/Log/Handler/ShutDown'  ));
      $this->OutPut    =$this->Add($this->Create_Object('/Log/Handler/OutPut'    ));
      
      Parent::_Init($Args);
    }
    
  };
?>