<?
  $Loader->Parent_Class('/Log/Handler/Base');
 
  Class C_Log_Handler_OutPut Extends C_Log_Handler_Base
  {
    Var Array  $Carry    =[];
    Var Int    $Ob_Level =  0  ;
    Var String $Mode     ='Debug'; // 'Error', 'Log', 'Pass', 'Ignore', 'Debug'

    Function _Init(Array $Args)
    {
      $this->Mode= $Args['Mode']?? $this->Mode; //PHP_SAPI==='cli'? 'Log':'Error';

      Parent::_Init($Args);
    }
    
    Function SetModeLog() { $this->Mode='Log'; }
    
    Function Handler($Chunk, Int $Phase)
    {
      Switch($this->Mode)
      {
      Case 'Log'    : Break;
      Case 'Pass'   : Return $Chunk;
      Case 'Error'  : Return $this->Log('Error', 'Start output from:')->BackTrace(0, 2)->Ret('');
      Case 'Ignore' : Return '';
      Case 'Debug'  :
        $Phase = Match($Phase) {
          PHP_OUTPUT_HANDLER_START=>'Start', // Indicates that output buffering has begun.
          PHP_OUTPUT_HANDLER_WRITE=>'Write', // Indicates that the output buffer is being flushed, and had data to output.
          PHP_OUTPUT_HANDLER_FLUSH=>'Flush', // Indicates that the buffer has been flushed.
          PHP_OUTPUT_HANDLER_CLEAN=>'Clean', // Indicates that the output buffer has been cleaned.
          PHP_OUTPUT_HANDLER_FINAL=>'Final', // Indicates that this is the final output buffering operation.
          default => 'Unknown'.$Phase,
        };
        $this->Log('Error', 'Output.', $Phase,': ',$Chunk)->BackTrace(0, 2);
        Return '';
      Default:
        $this->Log('Error', 'Unknown output handler mode:', $this->Mode);
        Return '';
      }
      
      
      $Carry = &$this->Carry;
      $Log   = Null;
      // разбираем по строкам: echo может прийти без \n на конце
      While (($Pos = StrPos($Chunk, "\n")) !== False)
      {
        $Line    = RTrim(SubStr($Chunk, 0, $Pos));
        $Chunk   =       SubStr($Chunk, $Pos + 1);
        
        If (StrLen($Line))  $Carry[] = $Line;
        
        // TODO: Partial output when "\n" hasn't received yet
        If ($Log)  $Log             (       ...$Carry);
        Else       $Log = $this->Log('Log', ...$Carry);
        
        $Carry = [];
        If (!StrLen($Chunk))
          Return;
      }
      $Carry []= $Chunk;
      Return ''; // наружу ничего не отдаём (или return $chunk, чтобы вывод шёл как обычно)
    }
    
    Function _Install():bool
    {
    //Ob_Implicit_Flush();
      $this->Ob_Level = Ob_Get_Level();
      If($this->Ob_Level!==0)
        $this->Log('Error', 'Ob_Level should be first for \Log\Handler\OutPut; Handlers: ', Ob_List_Handlers());
      Ob_Start($this->Handler(...), 1);
      Return True;
    }
    
    Function _UnInstall():bool
    {
      //Now just exit on error, but it can be fixed (may be), used ob_get_status(true) and ob_list_handlers()
      If($this->Ob_Level!==Ob_Get_Level())
        Return $this->Log('Error', 'Ob_End should be at the same level for \Log\Handler\OutPut; Actual: ', Ob_Get_Level(), '; Desired: ',$this->Ob_Level, '; Handlers: ', Ob_List_Handlers())->Ret(False);
      Ob_End_Flush();
      Return True;
    }
    
  //****************************************************************
  };
?>