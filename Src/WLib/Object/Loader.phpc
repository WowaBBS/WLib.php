<?
  NameSpace WLib\Object;

  Require_Once('LibType.phpt'  );
  Require_Once('LibPath.phpt'  );
  Require_Once('AutoLoad.phpt' );
  Require_Once('ShutDown.phpt' );
  Class_Alias(C_Loader::class, \C_Object_Loader::class);

  Class C_Loader
//Class C_Object_Loader
  {
    Var $_Paths =[];
    Var $_Libs  =[];
    Var $_Singleton  =[];
    Var $Included_Files=[]; //< TODO: Remove?
    Var $Paths ;
  //Var $LoadingClass='';
  
    Static ?Self $Loader=null; // TODO: Thread var
    
    Static Function Get() { Return Static::$Loader??=Static::_Get(); }
    Static Function _Get()
    {
      $Res=New Static();
      $Res->Loader_Init(DirName(__DIR__));
      return $Res;
    }
  
    Function __Construct()
    {
      $this->Map      =New \WeakMap();
      $this->LibTypes =T_LibType::CreateDefaultTypes();
      $this->Paths    =T_LibPath::GetDefaultList(); //TODO: Need?
    
      $this->AutoLoad=New T_AutoLoad($this);
      $this->ShutDown=New T_ShutDown($this);
    }
    
    Function __Destruct()
    {
      If($this->HasDispose) Return;
      If($this->HasDispose===False)
        $this->GetLogger()?->Log('Warning', 'OnDestruct: Loader hasn\'t destoyed');
      $this->Dispose();
    }
    
    Var $LibTypes=[];
    
    Function GetLibType($Type)
    {
      Return $this->LibTypes[$Type]??
        $this->Log('Fatal', 'Unknown LibType '.$Type)->Ret($this->LibTypes['Lib']);
    }
    
    Function AddLib(?String $Name, String $Path, ?String $Prefix=Null)
    {
      Return $this->_Paths[]=New T_LibPath($Name?? 'Lib'.Count($this->Paths), $Path, $Prefix?? ($Name? Null:''));
    //Return $this->_Paths[$Lib]=New T_LibPath($Name?? 'Lib'.Count($this->Paths), $Path, $Prefix?? ($Name? Null:''));
    //$this->Log('Log', 'AddSearchPath ', $this->Paths[Count($this->Paths)-1]->Path);
    }
    
    Function AddSearchPath($Path)
    { // TODO: Warning AddSearchPath is deprecated
      If(Is_Array($Path))
      {
        ForEach($Path As $Item)
          $this->AddSearchPath($Item);
        Return;
      }
      $this->AddLib(Null, $Path);
    }
 
    Function Loader_Init($APath_Libs)
    {
      $this->_Paths=[];
      $this->AddLib('WLib', $APath_Libs);
      $this->Load_Class('/Object/Base');
      $this->Load_Type('/Log/Item');
    }
    
    Function _Find_Lib(String $Name):?T_LibPath
    {
      If($Name[0]!=='/')
      {
        $this->Log('Error', 'Lib`s name "', $Name, '" should be started with /');
        $Name='/'.$Name;
      }
      
      ForEach($this->_Paths As $Lib)
        If($Res=$Lib->Check($this, $Name))
          Return $Lib;
      
      Return Null;
    }
    
    Function _Include($Include_Path, $Include_Vars=[], $Include_Type='Include') //?_Once
    {
      Extract($Include_Vars);
      Return Match($Include_Type){
        'Require'      =>Require      ($Include_Path),
        'Include'      =>Include      ($Include_Path),
        'Require_Once' =>Require_Once ($Include_Path),
        'Include_Once' =>Include_Once ($Include_Path),
      };
    }
    
    Function _Load_Lib(String $Name, Array $Mode=[], $Type='Lib')
    {
      $LibType=$this->GetLibType($Type);
        
      $LibState=&$this->_Libs[$LibType->NS][$Name];
      If(!Is_Null($LibState))
      {
        If($LibState!==True)
          Return $LibState;
        Return $this->Log('Error', 'Recursive loading ',$Type, ' ', $Name)->Ret();
      }
      
    //$Name=StrToLower($Name);
      If($Name[0]!=='/')
      {
        $this->Log('Error', 'Lib`s name "', $Name, '" should be started with /');
        Return $LibState=$this->_Load_Lib('/'.$Name, $Mode, $Type);
      }

      $PathName=Explode('/', $Name);
      Array_Shift($PathName); //Remove Empty
      $PrefixLib=$PathName[0];
      //TODO: Check prefix for lib
      
      $LibPath=$this->_Find_Lib($Name.$LibType->Ext       )
        ??     $this->_Find_Lib($Name.$LibType->Extension );
        
      $Res=False;
      If($LibPath)
      {
        $_Path=$LibPath->Found;
        $LibState=True; // Mark recursive checking
      //$Verify=$this->Verify? $this->_Verify($LibType, $TypeName):False;
        If($Res=$this->_Include($_Path, ['Loader'=>$this]))
        {
        //If($Verify) $Verify();
        
          $PathNick=Array_Pop($PathName);
          If($PathName)
            $PathName[]='';
          
          $TypeNames=[
            $LibPath->Prefix.Implode('\\', $PathName).$LibType->Prefix.$PathNick, // \NameSpace\PrefixName
            $LibType->Prefix.Implode('_', $PathName).$PathNick, // Previx_
          ];
          $TypeName=$this->_Check_Finish($LibType, $TypeNames, $_Path);
          $Res=$TypeName;
        }
      }
      
      $LibState=$Res;
      If($Res)
        $this->Included_Files[$Name.$LibType->Extension]=$_Path;
      Else
      {
        $Safe=$Mode['Safe']?? False;
        If(!$Safe)
          $this->Log('Fatal', 'Can`t load lib ',$Name.$LibType->Extension)->Ret();
      }
      Return $Res;
    }
    
    Function _Create_Object($Class_Name, Array $Args=[], Array $Mode=[])
    {
      If(!$Class_Name) Return $Class_Name;
     
    //$Args['Object_Outer'  ]??=$this; //$Args['Outer'  ]??=$this;
      $Args['Object_Loader' ]??=$this; //$Args['Loader' ]??=$this;
      $Res=New $Class_Name($Args);
     #ifdef Debug
     #if(Get_Class($Res)!==$Class_Name)
     #  this->Log('Error', 'Class name error: ', Get_Class($Res), '!==', $Class_Name);
     #endif // Debug
      Return $Res;
    }
    
    Function Create_Object($Name, Array $Args=[], Array $Mode=[])
    {
      $Class_Name=$this->Load_Class($Name, $Mode);
      Return $this->_Create_Object($Class_Name, $Args, $Mode);
    }
    
    Function Create_UnitTest($Name, Array $Args=[], Array $Mode=[])
    {
      $Class_Name=$this->Load_UnitTest($Name, $Mode);
      Return $this->_Create_Object($Class_Name, $Args, $Mode);
    }
    
    Function Get_Singleton($Name, Array $Args=[], Array $Mode=[])
    {
      $Key=Count($Args)? $Name.Serialize($Args):$Name;
    //this->Log('Log', 'GetSinlgeton(', $Key ,')[', Implode(', ', Array_Keys($S)), ']');
      Return $this->_Singleton[$Key] ??= $this->Create_Object($Name, $Args, $Mode);
    }
 
    Function Object($Name, Array $Args=[], Array $Mode=[])
    {
      throw new \Exception('Not implemented');
      //see: D:\MyWeb\_files\wlib\system\loader.phpc
      // This is creating singleton from System/Singleton/
    }
    
    Function Load_Lib       ($Name, Array $Mode=[]) { Return $this->_Load_Lib($Name, $Mode, 'Lib'       ); }
    Function Load_Module    ($Name, Array $Mode=[]) { Return $this->_Load_Lib($Name, $Mode, 'Module'    ); } // TODO: Rename lib
    Function Load_Type      ($Name, Array $Mode=[]) { Return $this->_Load_Lib($Name, $Mode, 'Type'      ); } // TODO: Rename struct
    Function Load_Struct    ($Name, Array $Mode=[]) { Return $this->_Load_Lib($Name, $Mode, 'Struct'    ); } // TODO: Rename struct
    Function Load_Class     ($Name, Array $Mode=[]) { Return $this->_Load_Lib($Name ,$Mode ,'Class'     ); }
    Function Load_Interface ($Name, Array $Mode=[]) { Return $this->_Load_Lib($Name ,$Mode ,'Interface' ); }
    Function Load_Trait     ($Name, Array $Mode=[]) { Return $this->_Load_Lib($Name ,$Mode ,'Trait'     ); }
    Function Load_Enum      ($Name, Array $Mode=[]) { Return $this->_Load_Lib($Name ,$Mode ,'Enum'      ); }
    Function Load_Exception ($Name, Array $Mode=[]) { Return $this->_Load_Lib($Name ,$Mode ,'Exception' ); }
    Function Load_UnitTest  ($Name, Array $Mode=[]) { Return $this->_Load_Lib($Name ,$Mode ,'UnitTest'  ); }
 
    Function Using_Class     ($Name) {}
    Function Using_Interface ($Name) { $this->Load_Interface ($Name); }
    Function Using_Module    ($Name) { $this->Load_Module    ($Name); } // TODO: Rename lib
    Function Using_Type      ($Name) { $this->Load_Type      ($Name); } // TODO: Rename struct
    Function Using_Struct    ($Name) { $this->Load_Struct    ($Name); } // TODO: Rename struct
    
    Function Class_Implements ($Name) { $this->Load_Interface ($Name); }
    Function Class_Extends    ($Name) { $this->Load_Class     ($Name); }
    Function Parent_Class     ($Name) { $this->Load_Class     ($Name); }
    Function Parent_Struct    ($Name) { $this->Load_Struct    ($Name); }
    
    Function Begin_Module () {}
    Function Begin_Class  () {}
    Function Begin_Type   () {}
    Function Begin_Lib    () {}
    
    Function End_Module () {}
    Function End_Class  () {}
    Function End_Type   () {}
    Function End_Lib    () {}

  //****************************************************************
  // Check
    Function _Check_Finish($LibType, $TypeNames, $Path)
    {
      $Check=$LibType->Check;
      If($Check===Null) Return $TypeNames[0];
      $Found=False;
      ForEach($TypeNames As $TypeName)
        If($Check($TypeName, False))
        {
          $Found=True;
          Break;
        }
      
      //Create aliaces for legacy
      //TODO: Check support legacy
      ForEach($TypeNames As $Aliace)
        If($TypeName!==$Aliace)
          $LibType->Aliace($TypeName, $Aliace, False);
      
      If(!$Found) Return $this->Log('Error', 'Check Finish ', $LibType->Type, ' ', $TypeNames, ' not found in ', $Path)->Ret($TypeName[0]);
      
      $Class=New \ReflectionClass($TypeName);
      $RealName=$Class->GetName();
      If($TypeName!==$RealName)
        $this->Log('Error', $LibType->Type, ' name error: ', $TypeName, ' in not same ', $RealName);
      Return $TypeName;
    }
    
  //****************************************************************
  // Old Verify functional
    
    Var $Verify=True;
    
    Function _Verify($LibType, $TypeName)
    {
      $Var=$this->_Verify_Begin($LibType);
      Return fn()=>$this->_Verify_End($LibType, $Var, $TypeName);
    }

    Function _Verify_Begin($LibType): Int { Return $LibType->GetListCount(); }
    
    Function _Verify_End($LibType, Int $Start, String $TypeName)
    {
      $List=$LibType->GetList();
      If(!$List) Return;
      $c=Count($List);
      For($i=$Start; $i<$c; $i++)
        If($List[$i]===$TypeName)
          Return True;
      For($i=$Start; $i<$c; $i++)
        If(StrCaseCmp($List[$i], $TypeName)===0)
        {
          $this->Log('Error', $LibType->Type, ' name error: ', $TypeName, ' in not same ', $List[$i]);
          Return True;
        }
      $this->Log('Error', 'Verify: ', $LibType->Type, ' ', $TypeName, ' not found');
    }

  //****************************************************************
  // Objects life time
    
    Var $Map;
  
    Function OnCreated   ($Obj, $Args) { $this->Map[$Obj]??=$this->Map[$Args['Object_Outer']?? $this]?? True; }
    Function UnMark      ($Obj       ) { $this->Map[$Obj]=False ; }
    Function OnDestroyed ($Obj       ) { $this->Map[$Obj]=Null  ; }
    
    Function CheckHasntDestroyed()
    {
      ForEach($this->Map As $Obj=>$v)
        If($v)
          $this->Log('Error', 'HasntDestroyed:')->Dump($Obj);
    }
    
  //****************************************************************
  // Debug And Log
    
    Var $Logger=null;
    
    #[Deprecated("Use Dump() instead")]
    Function Debug($Var, $Level=-1) { return $this->Dump($Var, $Level); }
    
    Function Dump($Var, $Level=-1) // TODO: Return Debug object
    {
      $Deb=$this->Get_Singleton('/Debug/Manager')->Get('Debug.txt');
      return $Deb->Dump($Var, $Level);
    }
    
    Function _CreateLogger()
    {
      $this->Logger=false;
      return $this->Logger=$this->Get_Singleton('/Log/Manager');
    }
    
    Function GetLogger() { return $this->Logger?? $this->_CreateLogger(); }
  //Function Log($LogLevel, ...$Args) { return New T_Log_Item($this, $this->GetLogger(), $LogLevel, $Args); }
    Function Log($LogLevel, ...$Args) { return New \WLib\Log\T_Item($this, $this->GetLogger(), $LogLevel, $Args); }

    Function ToDebugInfo() { return $this->_ToDebugInfo(); }
    Function _ToDebugInfo() { return 'Loader'; }
    
    Protected Function _Debug_Info(Array &$Res)
    {
      if($this->_Singleton) $Res['_Singleton']=Array_Keys($this->_Singleton);
      if($this->Logger) $Res['Logger']=Get_Class($this->Logger);
    }
    
    /// Debug manager
    Final Function _Debug_Serialize(Array &$Res) { $this->_Debug_Info($Res); }
    
    Final Function __debugInfo()
    {
    //throw new Exception('!!!!!!!!!!!!!!!!!!!!');
    //$Res=Get_Object_Vars($this);
      $Res=[];
      ForEach((Array)$this As $k=>$v)
      {
        $k=Explode("\0", $k);
        $Res[End($k)]=$v;
      }
      $this->_Debug_Info($Res);
      return $Res;
    }
    
  //****************************************************************
  // Dispose
    
    Var $HasDispose=False; //
    
    //** Called in case of an unhandled exception.
    Function Dispose_FailedCall()
    {
      $this->AutoDispose();
    }
    
    //TODO: #[Deprecated("Use Dispose() instead")]
    Function Done     () { Return $this->Dispose     (); }
    //TODO: #[Deprecated("Use AutoDispose() instead")] 
    Function AutoDone () { Return $this->AutoDispose (); }
    
    Function Dispose() //TODO: Rename to dispose
    {
      If($this->HasDispose)
      {
        $this->GetLogger()?->Log('Fatal', 'Loader.Dispose has already called');
        Return;
      }
      $this->HasDispose=True;
      $this->CheckHasntDestroyed();
    }
    
    Function AutoDispose() // On destruct
    {
      If($this->HasDispose===False)
        $this->HasDispose=Null;
      Else
        $this->GetLogger()?->Log('Fatal', 'Can\'t AutoDispose on destroyed'); //Unreachable
      Return $this;
    }
  
  //****************************************************************
  // Autoload
  
    Var $AutoLoad { Get=>$this->AutoLoad ??= New ($this->Load_Type('/Object/AutoLoad'))($this); }
    
  //****************************************************************
  // ShutDown
  
    Var $ShutSown { Get=>$this->ShutDown ??= New ($this->Load_Type('/Object/ShutDown'))($this); }
    
    Function OnShutDown()
    {
      If($this->HasDispose) Return;
      If($this->HasDispose===False) 
        $this->GetLogger()?->Log('Warning', 'OnShutDown: Loader hasn\'t destoyed');
      $this->Dispose();
    }
    
  //****************************************************************
  }

?>