<?
  for($F=__FILE__; $F;) if(@include($F=DirName($F)).'/Using.php') break;

  $Loader->GetLogger()->ScriptLog();
  $Reader=$Loader->Get_Singleton('/Parser/Bin/Reader', ['Chunk_Size'=>64, 'FilePath'=>__File__]);
  
  ForEach($Reader->Read_Chunks() As $Chunk)
  {
    $Loader->Log('Log', 'Chunk ',$Reader->Offset,':')->Debug($Chunk);
  }

?>