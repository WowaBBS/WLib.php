<?
  $this->Parent_Class('/Object');
  
  Class C_Parser_Text_RegExp Extends C_Object
  {
    Var $Texts    =[]; // Str    =>[Str    ,State, More, End  ],
    Var $RegExps  =[]; // RegExp =>[RegExp ,State, More ],
    
    Var $MapText  =[]; // text   =>State
  //Var $MapTo    =[]; // Id     =>State
    
    Var $FirstId ='First' ;
    Var $MoreId  ='More'  ;
    Var $TextId  ='Text'  ;
    
    Var $RegExp_More ='';
    Var $RegExp_Main ='';
    Var $RegExp_Cur  =[];
    
    Function _Init(Array $Args)
    {
      Parent::_Init($Args);
    }
    
    Function Text($Str, $To, $End=Null, $More=Null)
    {
      $str=StrToLower($Str);
      If($Old=$this->MapText[$str]?? Null)
        $this->Log('Error', 'Dublicate ', $Str, ' for ', $Old, ' and ', $To);
      Else
        $this->MapText[$str]=$To;
      $this->Texts[]=[$Str, $To, $More, $End];
    }

    Function RegExp($Str, $To, $More=Null)
    {
      If($More===True) $More=$Str;
      $this->RegExps[]=[$Str, $To, $More];
    }
    
    Static Function _MakeMoreStr(&$Res, $Str, $End)
    {
      $Len=StrLen($Str)+($End? 1:0);
      For($i=1; $i<$Len; $i++)
        $Res[]=SubStr($Str, 0, $i);
    }
    
    Function _Make_More()
    {
      $Res=[];
      ForEach($this->Texts As [$Str, $To, $More, $End])
        If($More)
          $Res[]=$More;
        Else
          Self::_MakeMoreStr($Res, $Str, $End);
      
      $Res=Array_Flip(Array_Flip($Res)); //< Remove duplicates
      $Res=Array_Map(Function($v) { Return Preg_Quote($v, '/'); }, $Res);
        
      ForEach($this->RegExps As [$Str, $To, $More])
        If($More)
          $Res[]=$More?? $Str;
      
      $Res=Implode('|', $Res);
      If($Res!=='')
      {
        $Res='(?:'.$Res.')$';
        If($Id=$this->MoreId)
          $Res='(?<'.$Id.'>'.$Res.')';
        Else
          $Res='(?:'.$Res.')';
      }
      $this->RegExp_More=$Res;
    //Return $Res;
    }
    
    Function _Make_RegExp()
    {
      $Res=[];
      ForEach($this->Texts As [$Str, $To, $More, $End])
        $Res[]=Preg_Quote($Str, '/').'(?='.$End.')';
      If($Res)
      {
        $Res=Array_Flip(Array_Flip($Res)); //< Remove duplicates
        $Res=Implode('|', $Res);
        $Id=$this->TextId;
        $Res=['(?<'.$Id.'>'.$Res.')'];
      }
      
      ForEach($this->RegExps As [$Str, $To, $More])
        $Res[]='(?<'.Preg_Quote($To, '/').'>'.$Str.')';
      $Res=Implode('|', $Res);
      
      If($Res!=='')
        $Res='(?:'.$Res.')';
      $this->RegExp_Main=$Res;
    }
    
    Function MakeRegExp($More, $End=False, $First=True)
    {
    //If($this->RegExp_More==='') $More=False;
      $Res='';
      If($this->RegExp_Main!=='')
      {
        If($More && $this->RegExp_More!=='')
        {
          $Res=$this->RegExp_More.'|';
        //If(!$More) $Res=Str_Replace('|$', '' $Res);
        }
        $Res.=$this->RegExp_Main;
        If($End)
          $Res.='(?<End>.*?)'; //TODO: Without the End
        Else
          $Res.='|$';
      //If($End || $More)
          $Res= '(?:'.$Res.')';
        If($End)
          $Res.='?$'; //TODO: Without the End
        
        //First
        If($First===True)
          $First=$this->FirstId;
        If($First!==False)
          $Res='(?<'.$First.'>.*?)'.$Res;
        
        $Res='/'.$Res.'/JSDsi';
      }
      $this->RegExp_Cur[$More]=$Res;
      Return $Res;
    }
    
    Protected Static Function _Texts_Cmp($a, $b)
    { //[$Str, $To, $More, $End]
      Return -(StrLen($a[0])<=>StrLen($b[0])) ?: $a[0]<=>$b[0];
    }
    
    Function Finish()
    {
      UASort($this->Texts, Static::_Texts_Cmp(...));
      $this->_Make_More();
      $this->_Make_RegExp();
      $this->MakeRegExp(False );
      $this->MakeRegExp(True  );
    }
    
    Function Parse(&$First, &$Type, &$Token, $Data, &$Offset, $More=False) //TODO: Return [First, Type, Data];
    {
    //If($Offset>=StrLen($Data)) { Yield 'More'=>''; Return; }
      $r=$this->RegExp_Cur[$More];
      If($r==='')
      {
        $Type='Error/NoRegExp'; $Token=SubStr($Data, $Offset);
        $Offset+=StrLen($Token);
        Return;
      }
      
      If(!Preg_Match($r, $Data, $M, 0, $Offset))//, PREG_UNMATCHED_AS_NULL); //|PREG_OFFSET_CAPTURE
      {
        $Type='Error/NoMatch'; $Token=SubStr($Data, $Offset);
        $Offset+=StrLen($Token);
        Return;
      }
      
      If($M[0]==='') // Fixed by D modifier
      {
        $Type='Error/EmptyMatch'; $Token=SubStr($Data, $Offset);
        $Offset+=StrLen($Token);
      //Yield 'More'=>'';
        Return;
      }
      
    //$this->Log('Debug', 'Match: ', [SubStr($Data, $Offset)], '=>', $M);
    //$R=[];
      ForEach($M  As $k=>$v)
        If(Is_String($k) && StrLen($v))
        {
        //$R[$k]=$i;
          If($k===$this->FirstId ) { $First=$v; $Offset+=StrLen($v); Continue; }
          If($k===$this->MoreId  ) $k='More'  ; Else
          If($k===$this->TextId  ) $k=$this->MapText[$v]??=$this->MapText[StrToLower($v)]?? $this->Log('Error', 'Unknown key ', [$v])->Ret('Error/Unknown');
          
          If($k!=='More')
            $Offset+=StrLen($v);
          
          If(!$Type)
          {
            $Type  =$k;
            $Token =$v;
          }
          Else // Unexcepted case
          {
            If($Type!=='Error/Mixed')
            {
              $this->Log('Error', 'Type ',$Type,' has alreaddy exists ', $k);
              $Token=$Type.'=>'.$Token;
              $Type ='Error/Mixed';
            }
            $Token=';'.$k.'=>'.$v;
          }
        }
    }

    Function ParseMap($Data, &$Offset, $More=False)
    {
      $First ='';
      $Type  ='';
      $Token ='';
      $this->Parse($First, $Type, $Token, $Data, $Offset, $More);
      $Res=[];
      If(StrLen($First)) $Res['First' ]=$First;
      If(StrLen($Token)) $Res[$Type   ]=$Token;
      Return $Res;
    }
  }
?>