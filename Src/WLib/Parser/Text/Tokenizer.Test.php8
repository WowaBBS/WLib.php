<?
  for($F=__FILE__; $F;) if(@include($F=DirName($F)).'/Using.php') break;
  
  Set_Time_Limit(3);

  $FilePath=__DIR__.'/Sapmle.php8'; //__FILE__;
  $Loader->GetLogger()->Add('Tokenizer.Test.log');
  $Factory=$Loader->Get_Singleton('/CharSet/Factory');

  $Content=File_Get_Contents($FilePath);
  
  $Rules=[
    '/Content'=>['First', '/Start'],
    '/Start'=>['Union',
      '/Short'  =>['Str', '<?'    ,'>To'=>'/../../PHP', '>Condition'=>'ShortTags'],
      '/Assign' =>['Str', '<?='   ,'>To'=>'/../../PHP'],
      '/PHP'    =>['Str', '<?php' ,'>To'=>'/../../PHP', '>End'=>'\W|$'],
    ],
    '/PHP'=>['Union',
      '/Space' =>['RegExp' ,'\s+'], //, '>Prefix'=>True
      '/Word'  =>['RegExp' ,'[a-z_][\\w_]*', '>End'=>'[^\w_]|$', '>More'=>True],
      '/Rem'   =>['Union'  ,
        '/Sharp'    =>['Str' ,'#', '>To'=>'/Content',
          '/Content' =>['First' ,'/End'],
          '/End'     =>['Str' ,"\n", '>To'=>'/PHP'],
        ],
        '/Inline'   =>['Str' ,'//', '>To'=>'/Content',
          '/Content' =>['First' ,'/End'],
          '/End'     =>['Str' ,"\n", '>To'=>'/PHP'],
        ],
        '/MutiLine' =>['Str' ,'/*', '>To'=>'/Content',
          '/Content' =>['First' ,'/End'],
          '/End'     =>['Str' ,'*/', '>To'=>'/PHP'],
        ],
      ],
      '/Float'   =>['RegExp' ,'(?:(?:{LNum}|{DNum})[eE][+-]?{LNum})', '>Vars'=>['LNum'=>'\d+(_\d+)*', 'DNum'=>'(?:{LNum}?.{LNum})|(?:{LNum}.{LNum}?)'], '>More'=>True], //TODO: End
      '/Numeric' =>['Union',
      //'/Dec' =>['RegExp' ,'\d+', '>End'=>'[^\w_\\.e]|$', '>More'=>True],
        '/Dec' =>['RegExp' ,'[1-9]\d*(?:_\d+)*|0(?:_0+)*', '>End'=>'[~\w_\\.]|$', '>More'=>True], // _ -- PHP 7.4.0
        '/Hex' =>['RegExp' ,'0[xX][\da-fA-F]+(?:_[\da-fA-F]+)*', '>More'=>True],
        '/Oct' =>['RegExp' ,'0[oO]?[0-7]+(?:_[0-7]+)*', '>More'=>True], // oO -- PHP 8.1.0
        '/Bin' =>['RegExp' ,'0[bB][01]+(?:_[01]+)*', '>More'=>True],
      ],
      '/String'=>['Union',
        '/Single'  =>['Str' ,"'", '>To'=>'/Content',
          '/Content' =>['First' ,'/Quoted', '/End'],
          '/Quoted'  =>['Str' ,"\\'" ,"\\\\"],
          '/End'     =>['Str' ,"'", '>To'=>'/PHP'],
        ],
        '/Double'  =>['Str' ,'"', '>To'=>'/Content',
          '/Content' =>['First' ,'/Quoted', '/End'],
          '/Quoted'  =>['RegExp' ,'\\\\.'],
          '/End'     =>['Str' ,'"', '>To'=>'/PHP'],
        ],
        '/HereDoc' =>['Str' ,'<<<' ,'>To'=>'/TODO'], //'>To'=>'/String/HereDoc'
        //'NowDoc'
      ],
      '/Execute'  =>['Str' ,'`'],
      '/Operator' =>['Union',
        '/Brackets' =>['Str', '[', ']', '(', ')', '{', '}'],
        '/Unary'    =>['Str', '++', '--', '~', '@', '$'], // -, +
        '/Arrow'    =>['Str', '->', '?->', '.'],
        '/Compare'  =>['Str', '=='. '==='. '!='. '!==', '<', '<=', '>', '>=', '<=>'
        //'StarShip'=>['Str', '<=>', '>Condition'=>'StarShip'],
        ],
        '/Binary'   =>['Str', '+', '-', '*', '/',  '%',  '|', '&',  '^'],
        '/Binary2'  =>['Str', '||','&&', '<<', '>>'],
        '/Control'  =>['Str', '?', '??', '?:', ',', ':', ';'],
        '/Assign'   =>['Str', '=', '??=', '?:=', '+=', '-=', '*=', '/=', '.=', '%=', '|=', '&=', '^=', '||=', '&&=', '<<=', '>>=',],
        '/Pipe'     =>['Str', '|>', '>Condition'=>'Pipe'],
        '/Args'     =>['Str', '...'],
      ],
      '/Attribute' =>['Str' ,"#[", '>To'=>'/TODO'],
      '/End'       =>['Str' ,'?>', '>To'=>'/Content'],
      '/TODO'      =>['TODO'],
    /* */
    ],
    
  //'string_single'  =>[['RegExp'  ,"'[^'\\\\]*(?:[\\\\.][^'\\\\]*)*'"],],
  //'string_double'  =>[['RegExp'  ,'"[^"\\\\]*(?:[\\\\.][^"\\\\]*)*"'],],
  //'string_heredoc' =>[
  //  ['RegExp'  ,'<<<'],
  //  ['RegExp'  ,'([\\w_][\\w_\\d]*)', 'class'=>'string_heredoc_id'],
  //  ['AnyChars', 'class'=>'string_heredoc_value'],
  //  ['RegExp'  ,'\\n'],
  //  ['BackValue' ,-1],
  //  ['RegExp'  ,';\\n'],
  //],
  //'rem1'     =>['RegExp' ,'\\#[^\\n]*[\\n]?'                          ],
  //'rem2'     =>['RegExp' ,'\\/\\/[^\\n]*[\\n]?'                       ],
  //'rem3'     =>['RegExp' ,'\\/\\*.*?\\*\\/'                           ],
  //'execute'  =>['RegExp' ,'`"[^`]*`'                                  ],
  //'float'    =>['RegExp' ,'\\d+(?:\\.\\d+(?:e[+-]?\\d+)?|e[+-]?\\d+)' ],
  //'integer'  =>['RegExp' ,'\\d+'                                      ],
  //'word'     =>['RegExp' ,'[\\w_][\\w_\\d]*'                          ],
  ];

  $Reader=$Loader->Create_Object('/Parser/Text/Tokenizer', [
    'Chunk_Size' =>64        ,
    'FilePath'   =>$FilePath ,
    'Content'    =>$Content  ,
    'Rules'      =>$Rules    ,
    'Start'      =>'/Content',
  ]);

  ForEach($Reader->Read_Tokens() As $Type=>$Token)
  {
    $Loader->Log('Log', 'Token ',$Type, ': ', [$Token]);
  }
  
//$Loader->Log('Debug')->Debug($Reader);
?>