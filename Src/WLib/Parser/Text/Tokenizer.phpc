<?
  $this->Parent_Class('/Parser/Text/Reader');
  
  Class C_Parser_Text_Tokenizer Extends C_Parser_Text_Reader
  {
    Var $Rules=Null;
    Var $Start='';
    
    Function _Init(Array $Args)
    {
      $this->Start   =$Args['Start'] ;
      Parent::_Init($Args);
      $this->SetRules($Args['Rules']);
    }

    Function SetRules($v)
    {
      $this->Rules=$this->Create_Rule('', $v+['Type'=>'Rules']);
    }
 
    Function Create_Rule($Name, $Rules, $Parent=Null)
    {
      If(Array_Key_Exists($k='Type' ,$Rules)) { $Type=$Rules[$k]; UnSet($Rules[$k]); } Else
      If(Array_Key_Exists($k=0      ,$Rules)) { $Type=$Rules[$k]; UnSet($Rules[$k]); } Else
        $Type=$this->Log('Error', 'Unknown type of the rule')->Ret('Base');
      If($Type[0]!=='/')
        $Type='/Parser/Text/Type/'.$Type;
      $Args=[
        'Name'      =>$Name   ,
        'Rules'     =>$Rules  ,
        'Tokenizer' =>$this   ,
        'Parent'    =>$Parent ,
      ];
      $Res=$this->Create_Object($Type, $Args);
      If($Parent)
        $Parent->OnChild($Res);
      Return $Res;
    }
    
    Function GetRule($Name ) { Return $Name ?$this->Rules->GetRule($Name ):Null; }
    Function GetById($Id   ) { Return $Id   ?$this->Rules->GetById($Id   ):Null; }
  //****************************************************************
  
    Var $State    =Null;
    Var $Chunk    ='';
    Var $Offset   =0 ;
  //Var $NeedMore =False;
  
    Function _Rest_Tokens($End)
    {
      $Parser=$this; // Now it's the Tokenizer
      While(StrLen($this->Chunk)>$this->Offset)
        ForEach($this->State->Parse($Parser, $this->Chunk, $this->Offset, !$End)As $k=>$v)
          If($k==='More')
            Return;
          Else
            Yield $k=>$v;
    }
    
    Function SetState($To)
    {
      If(!$To) Return;
      If(Is_String($To)) $To=$this->GetRule($To);
    //$this->Log('Debug', 'SetState: ',$To->GetFullName());
      $this->State=$To;
    }
    
    Function Read_Tokens($Chunks=Null)
    {
      $Chunks=Parent::Read_Tokens($Chunks);
      
      $this->Chunk  ='';
      $this->Offset =0;
      $this->SetState($this->Start);
      $Rest='';
      ForEach($Chunks As $Chunk)
      {
        If(StrLen($Rest))
          $Chunk=$Rest.$Chunk;
        
        $this->Chunk  =$Chunk;
        $this->Offset =0;
        Yield From $this->_Rest_Tokens(False);
        $Rest=SubStr($this->Chunk, $this->Offset);
      }
      Yield From $this->_Rest_Tokens(True);
      If(StrLen($Rest))
        Yield 'Error/Rest'=>$Rest;
    }
   
  //****************************************************************
  }
?>