<?
  $this->Load_Class('/Object');
  
  Class C_Parser_Text_Type_Base Extends C_Object
  {
    Var $Tokenizer =Null; //TODO: Remove. Use Rules instead of
    Var $Parent    =Null;
  //Var $Args      =[];
  //Var $Sub       =[];
    Var $To        =Null; // Change state
    Var $Name      ='';
    Var $FullName  ='';
    Var $Id        ='';
    Var $Condition =[];
  
    Function _Init($Args)
    {
      $Rules=$Args['Rules'];
      
    //$Hide=($v=$Rules[$k='>Hide'])
      $this->Tokenizer =$Args['Tokenizer' ] ->Object_GetWeak();
      $this->Parent    =$Args['Parent'    ]?->Object_GetWeak();
      $this->Name      =$Args['Name'      ];
      $this->FullName  =($this->GetParent()?->FullName?? '').$this->Name;
    //$this->Id        =StrTr($this->FullName, '/', '_'); ['/'=>'']);
      $this->Id        =Str_Replace('/', '', $this->FullName); //TODO: Numeric
      Parent::_Init($Args);
      $this->InitRules($Rules);
    }
    
    Function GetTokenizer () { Return $this->Tokenizer->Get(); }
    Function GetParent    () { Return $this->Parent  ?->Get(); }
    Function GetTo        () { Return $this->To?? $this->GetParent()?->GetTo(); }
    Function GetToRule    () { Return $this->GetRule($this->GetTo()); }
    Function GetId        () { Return $this->Id; }
    Function GetName      () { Return $this->Name; }
    Function GetTokenName () { Return $this->FullName; }
    Function GetFullName  () { Return $this->FullName; }
    
    Function Init_Params($k, $v)
    {
      Switch($k)
      {
      Case '>Condition' : $this->Condition =$v; Return True;
      Case '>To'        : $this->To        =$v; Return True;
      }
      Return False;
    }
    
    Function InitRules($List)
    {
      $Tokenizer=$this->GetTokenizer();
    
      $Sub=[];
      $Args=[];
      ForEach($List As $k=>$v)
        If(Is_String($k))
        {
          If($k!=='')
          {
            Switch($k[0])
            {
            Case '>': //TODO: Map
              If(!$this->Init_Params($k, $v))
                $this->Log('Error', 'Unknown param ', $k, '=>', $v); //TODO: In
              UnSet($List[$k]);
              Break;
            Case '/':
              $R=$Tokenizer->Create_Rule($k, $v, $this);
              $Sub[$k]=$R;
              UnSet($List[$k]);
              Break;
            }
          }
        }
        ElseIf(Is_Integer($k))
        {
          $Args[]=$v;
          UnSet($List[$k]);
        }
    
    //If($Sub) $this->_Init_Sub($Sub);
      
      If(!$this->_Init_Args($Args) && Count($Args))
        $this->Log('Error', 'Args ',$Args,' are not allowed in ', $this->FullName);
      $this->_Init_Rules($List);
      
      If($List)
        $this->Log('Error', 'Not all rules have been processed in ', $this->FullName)->Debug($List);
    }
    
    Function _Init_Args(Array $Args) { Return False; }
    Function _Init_Rules(Array &$List) { }
  //Function _Init_Sub(Array $List) { $this->Log('Error', 'Sub is not supported in ', $this->FullName)->Debug($List); }
    
  //****************************************************************
  // Children
  
    Var $Children=[];
  
    Function OnChild($Child, $Prefix='')
    {
      $this->Children[$Prefix.$Child->GetName()]=$Child;
      If($Parent=$this->GetParent())
        $Parent->OnChild($Child, $this->Name.$Prefix);
    }
    
    Function _GetRule($Id)
    {
      Return $this->Children[$Id]?? 
        $this->GetParent()?->_GetRule($Id);
    }
    
    Function _GetAllRules() { Return $this->Children+($this->GetParent()?->_GetAllRules()?? []); }

    Function GetRule($Id)
    {
      If($Id===Null) Return Null;
      If($Id==='') Return $this;
      
      If(Str_Starts_With($Id, '/..'))
        If($Parent=$this->GetParent())
          Return $Parent->GetRule(SubStr($Id, 3));
      
      Return $this->_GetRule($Id)?? 
        $this->Log('Error', 'Unknown ', $Id, ' in ', Array_Keys($this->_GetAllRules()))->Ret();
    }
  
  //****************************************************************
  
    Function OnFirst($First)
    {
      $this->Log('Error', 'Unexpected First: ', $First);
      Return 'Error/First';
    }
    
    Function OnToken($Parser, $Token)
    {
      Yield $this->GetTokenName()=>$Token;
      If($To=$this->GetToRule())
        $Parser->SetState($To);
    }
    
  //****************************************************************
  // RegExp
  
    Var $RegExp_Cached = Null;
    
    Function Parse($Parser, $Chunk, &$Offset, $End)
    {
      $RegExp=$this->Get_RegExp();
      $First ='';
      $Type  ='';
      $Token ='';
      $RegExp->Parse($First, $Type, $Token, $Chunk, $Offset, $End);
      If(StrLen($First))
      {
      //$this->Log('Debug', 'First: ', $First);
        Yield $this->OnFirst($First)=>$First;
      }
      If(!StrLen($Type)) Return;
      If($Type==='More') { Yield 'More'=>$Token;  Return; }
      If($State=$Parser->GetById($Type))
        Yield From $State->OnToken($Parser, $Token);
      Else
      {
        $this->Log('Error', 'UnknownState: ', $Type, '=>', $Token);
        Yield 'Error/UnknownState/'.$Type=>$Token;
      }
    }
    
    Function _Get_RegExp()
    {
      $Res=$this->Create_Object('/Parser/Text/RegExp');
      $this->_Init_RegExp($Res);
      $Res->Finish();
      $this->Log('Debug', 'RegExp: ', $Res->RegExp_Cur);
      Return $Res;
    }
    
    Function _Init_RegExp($Res)
    {
    }
    
    Function Get_RegExp()
    {
      Return $this->RegExp_Cached??=$this->_Get_RegExp();
    }

    Function GetSubRegExp(&$Map, $Sub=False)
    {
      $Res=[];
      ForEach($this->Sub As $SubRule)
        $Res[]=$SubRule->GetRegExp($Map, $Sub);
      Return '(?:'.Implode('|', $Res).')';
    }

  //****************************************************************
  }
?>