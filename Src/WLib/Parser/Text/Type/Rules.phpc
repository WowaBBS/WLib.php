<?
  $this->Load_Class('/Parser/Text/Type/Base');
  
  Class C_Parser_Text_Type_Rules Extends C_Parser_Text_Type_Base
  {
    Var $End  =Null;
    Var $More =Null;

    Function Init_Params($k, $v)
    {
      Switch($k)
      {
      Case '>End'  ; $this->End  =$v; Return True;
      Case '>More' ; $this->More =$v; Return True;
      }
      Return Parent::Init_Params($k, $v);
    }
    
    Function _Init_Args(Array $Args) { Return True; } // $this->Children=$Args; Return Count($Args)>0; } // TODO: Check is is strings
  //Function _Init_Args(Array $Args) { $this->Children=$Args; Return Count($Args)>0; } // TODO: Check is is strings
  //Function _Init_Sub(Array $List) {}

    Var $ById=[];
    
    Function GetById($Id) { Return $Id? ($this->ById[$Id]?? $this->Log('Error', 'Unknown ', $Id, ' in ', Array_Keys($this->ById))->Ret()):Null; }
    
    Function OnChild($Child, $Prefix='')
    {
      Parent::OnChild($Child, $Prefix);
      $this->ById[$Child->GetId()]=$Child;
    }

  }
?>