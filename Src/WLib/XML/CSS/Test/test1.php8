  $Str='margin:0cm; margin-bottom:.0001pt; font-size:10.0pt; font-family:"Times New Roman" 1; a:(a:b; a)';
//Dump(ParseStyle($Str));
 
  $Style=$Loader->Create_Object('/XML/CSS/Style');
